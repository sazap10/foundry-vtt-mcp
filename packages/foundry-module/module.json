{
  "id": "foundry-mcp-bridge",
  "title": "Foundry MCP Bridge (Cosmere fork)",
  "description": "Connect Foundry VTT to AI models through MCP protocol. Enable AI-powered actor creation, intelligent compendium search, campaign analysis, and interactive dice roll coordination. Cosmere RPG fork: adds adversary creature indexing (tier/role/defenses) for the cosmere-rpg system on top of the upstream D&D 5e and Pathfinder 2e support.",
  "version": "0.8.5-cosmere1",
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Adam Dooley",
      "email": "adambriandooley@gmail.com",
      "url": "https://github.com/adambdooley"
    },
    {
      "name": "Sachin Pande (Cosmere RPG support)",
      "url": "https://github.com/sazap10"
    }
  ],
  "url": "https://github.com/sazap10/foundry-vtt-mcp",
  "bugs": "https://github.com/sazap10/foundry-vtt-mcp/issues",
  "changelog": "https://github.com/sazap10/foundry-vtt-mcp/releases",
  "readme": "https://github.com/sazap10/foundry-vtt-mcp/blob/release_cosmere/README.md",
  "license": "https://github.com/sazap10/foundry-vtt-mcp/blob/release_cosmere/LICENSE",
  "esmodules": [
    "dist/main.js"
  ],
  "styles": [
    "styles/module.css",
    "styles/enhanced-creature-index.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "manifest": "https://raw.githubusercontent.com/sazap10/foundry-vtt-mcp/release_cosmere/packages/foundry-module/module.json",
  "download": "https://raw.githubusercontent.com/sazap10/foundry-vtt-mcp/release_cosmere/packages/foundry-module/foundry-vtt-mcp.zip",
  "protected": false,
  "coreTranslation": false,
  "library": false,
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["scripts", "styles", "templates", "lang"]
    }
  }
}
